@page
@model Competition.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Přihlášení administrátora";
}

<main class="shell">
    <section class="panel hero">
        <p class="eyebrow">Administrace</p>
        <h1>Je vyžadováno přihlášení</h1>
        <p class="lead">Pro pokračování do administrace se přihlaste.</p>
        <a class="button button-ghost" asp-page="/Index">Zpět na odpočet</a>
    </section>
</main>

<div class="modal-backdrop" id="loginModal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="loginTitle">
        <h2 id="loginTitle">Přihlášení</h2>
        <p>Zadejte přihlašovací údaje administrátora.</p>

        <form method="post" class="login-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="error"></div>

            <label asp-for="Credentials.Username"></label>
            <input asp-for="Credentials.Username" autocomplete="username" autofocus />
            <span asp-validation-for="Credentials.Username" class="field-error"></span>

            <label asp-for="Credentials.Password"></label>
            <input asp-for="Credentials.Password" autocomplete="current-password" />
            <span asp-validation-for="Credentials.Password" class="field-error"></span>

            <div class="modal-actions">
                <button class="button" type="submit">Pokračovat</button>
                <a class="button button-ghost" asp-page="/Index">Zrušit</a>
            </div>
        </form>
    </div>
</div>
