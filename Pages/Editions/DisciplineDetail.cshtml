@page "/Editions/{id:long}/Disciplines/{disciplineId:long}"
@model Competition.Pages.Editions.DisciplineDetailModel
@using Competition.Domain
@using Competition.Services

@{
    ViewData["Title"] = $"{Model.Setup.Discipline.Name} – {Model.Setup.EditionName}";
    var item = Model.Setup.Discipline;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && !item.IsClosed;
    var canChangePlayingSystem = !item.IsScheduleLocked;
    var setSettingsLocked = item.HasResults;
    var isBonusPointRulesPostback = HttpMethods.IsPost(Request.Method)
        && string.Equals(Request.Query["handler"], "SetBonusPointRules", StringComparison.OrdinalIgnoreCase);
    var selectedPointSystem = Model.Scoring.AwardPointSystemId is null
        ? null
        : Model.Scoring.AvailableSystems.SingleOrDefault(system => system.Id == Model.Scoring.AwardPointSystemId);
}

<main class="shell shell-wide">
    <section class="panel admin discipline-detail-page">
        <div class="page-heading">
            <div>
                <div class="edition-title">
                    <span class="seed-badge">@item.Order</span>
                    <h1>@item.Name</h1>
                </div>
                <p class="lead">@Model.Setup.EditionName</p>
            </div>
            <div class="action-group">
                @if (isAdmin)
                {
                    <form method="post" asp-page-handler="@(item.IsLocked ? "Unlock" : "Lock")">
                        <button class="button" type="submit">
                            @(item.IsLocked ? "Odemknout disciplínu" : "Uzamknout disciplínu")
                        </button>
                    </form>
                }
                <a class="button button-ghost" asp-page="/Editions/Disciplines" asp-route-id="@Model.Setup.EditionId">Zpět</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="status-message" role="status">@Model.StatusMessage</div>
        }
        @if (!isBonusPointRulesPostback)
        {
            <div asp-validation-summary="ModelOnly" class="error validation-panel"></div>
        }

        @if (item.IsLocked && !item.IsClosed)
        {
            <div class="schedule-lock-notice" role="status">
                <strong>Nastavení disciplíny je uzamčené.</strong>
                Pro úpravy jej nejprve odemkněte. Toto nemá vliv na vytváření rozpisu nebo vkládání výsledků, ale jen na nastavení disciplíny na této stránce.
            </div>
        }

        @if (item.IsClosed)
        {
            <div class="schedule-lock-notice closed-state-notice" role="status">
                <strong>Disciplína je uzavřená.</strong>
                Konečné pořadí a body byly přiděleny; nastavení, účastníky, týmy, rozpis ani výsledky už nelze měnit.
            </div>
        }

        <section class="registration-form discipline-scoring-section" aria-labelledby="discipline-scoring-title">
            <h2 id="discipline-scoring-title">Bodování pořadí</h2>
            @if (isAdmin && !item.IsLocked)
            {
                <form method="post"
                      asp-page-handler="SetPointSystem"
                      class="discipline-settings-grid"
                      data-point-system-assignment
                      data-initial-value="@(Model.Scoring.AwardPointSystemId?.ToString() ?? string.Empty)">
                    <div>
                        <label asp-for="AwardPointSystemId">Bodovací systém</label>
                        <select asp-for="AwardPointSystemId" data-point-system-select>
                            <option value="">Vyberte systém</option>
                            @foreach (var system in Model.Scoring.AvailableSystems)
                            {
                                <option value="@system.Id">@system.Name -  @string.Join(", ", system.Rules.Select(rule => $"{rule.Rank}. {rule.Points}b."))</option>
                            }
                        </select>
                    </div>
                    <button class="button button-small" type="submit" data-point-system-submit disabled>Přiřadit</button>
                </form>
                @if (Model.Scoring.AwardPointSystemId is not null)
                {
                    <details class="point-system-inline-editor">
                        <summary>Upravit bodování pro tuto disciplínu</summary>
                        <form method="post" asp-page-handler="UpdatePointSystem" data-point-system-form data-prefix="EditPointSystem">
                            <input type="hidden" name="systemId" value="@Model.Scoring.AwardPointSystemId" />
                            <label asp-for="EditPointSystem.Name">Název</label>
                            <input asp-for="EditPointSystem.Name" class="point-system-name-input" maxlength="120" />
                            <small>Uložením vznikne samostatná kopie systému použitá pouze pro tuto disciplínu.</small>
                            <div class="point-rule-list" data-rule-list>
                                @for (var index = 0; index < Model.EditPointSystem.Rules.Count; index++)
                                {
                                    <div class="point-rule-row">
                                        <label>Pořadí <input asp-for="EditPointSystem.Rules[index].Rank" type="number" min="1" readonly /></label>
                                        <label>Body <input asp-for="EditPointSystem.Rules[index].Points" type="number" min="0" /></label>
                                    </div>
                                }
                            </div>
                            <div class="form-actions">
                                <button class="button button-ghost button-small" type="button" data-add-rule>Přidat pořadí</button>
                                <button class="button button-ghost button-small" type="button" data-remove-rule>Odebrat poslední</button>
                                <button class="button button-small point-system-save-button" type="submit">Uložit bodování</button>
                            </div>
                        </form>
                    </details>
                }
                <details class="point-system-inline-editor">
                    <summary>Vytvořit nový systém a přiřadit jej</summary>
                    <form method="post" asp-page-handler="CreatePointSystem" data-point-system-form data-prefix="NewPointSystem">
                        <label asp-for="NewPointSystem.Name">Název</label>
                        <input asp-for="NewPointSystem.Name" class="point-system-name-input" maxlength="120" />
                        <div class="point-rule-list" data-rule-list>
                            @for (var index = 0; index < Model.NewPointSystem.Rules.Count; index++)
                            {
                                <div class="point-rule-row">
                                    <label>Pořadí <input asp-for="NewPointSystem.Rules[index].Rank" type="number" min="1" readonly /></label>
                                    <label>Body <input asp-for="NewPointSystem.Rules[index].Points" type="number" min="0" /></label>
                                </div>
                            }
                        </div>
                        <div class="form-actions">
                            <button class="button button-ghost button-small" type="button" data-add-rule>Přidat pořadí</button>
                            <button class="button button-ghost button-small" type="button" data-remove-rule>Odebrat poslední</button>
                            <button class="button button-small" type="submit">Vytvořit a přiřadit</button>
                        </div>
                    </form>
                </details>
            }
            else
            {
                @if (selectedPointSystem is null)
                {
                    <p class="meta-inline">Bodovací systém zatím není vybraný.</p>
                }
                else
                {
                    <div class="point-system-rules-summary" aria-label="Body za pořadí">
                        @foreach (var rule in selectedPointSystem.Rules)
                        {
                            <span><strong>@rule.Rank.</strong> místo <strong>@rule.Points b.</strong></span>
                        }
                    </div>
                }
            }
        </section>

        @if (isBonusPointRulesPostback)
        {
            <div asp-validation-summary="ModelOnly" class="error validation-panel local-validation-panel"></div>
        }
        <section class="registration-form discipline-bonus-section" aria-labelledby="discipline-bonus-title">
            <h2 id="discipline-bonus-title">Bonusové body</h2>
            <p class="meta-inline">
                Hodnotí se průměr na odehraný zápas. Při shodě získají plný počet bodů všechny nejlepší týmy.
            </p>
            @if (isAdmin && !item.IsLocked)
            {
                <form method="post"
                      asp-page-handler="SetBonusPointRules"
                      class="bonus-rule-form"
                      data-bonus-rule-form>
                    @for (var index = 0; index < Model.BonusPointRules.Count; index++)
                    {
                        var rule = Model.BonusPointRules[index];
                        var unavailable = rule.Type == BonusPointType.LowestAverageSubscoreAgainst && !item.UsesSetScores;
                        <div class="bonus-rule-row @(unavailable ? "is-disabled" : null)"
                             data-requires-set-scores="@((rule.Type == BonusPointType.LowestAverageSubscoreAgainst).ToString().ToLowerInvariant())">
                            <input asp-for="BonusPointRules[index].Type" type="hidden" />
                            <label class="checkbox-label bonus-rule-label">
                                <input asp-for="BonusPointRules[index].Enabled"
                                       type="checkbox"
                                       data-bonus-rule-autosubmit
                                       disabled="@unavailable" />
                                <span>@BonusPointTypeLabels.Get(rule.Type)</span>
                            </label>
                            @if (unavailable)
                            {
                                <input asp-for="BonusPointRules[index].Enabled" type="hidden" value="false" />
                            }
                            <label class="bonus-rule-points">
                                <span>Bonus:</span>
                                <input asp-for="BonusPointRules[index].Points"
                                       type="number"
                                       min="0"
                                       max="1000"
                                       data-bonus-rule-autosubmit
                                       disabled="@unavailable" />
                                <span>b.</span>
                            </label>
                        </div>
                    }
                </form>
            }
            else if (Model.Scoring.BonusRules is { Count: > 0 })
            {
                <div class="bonus-rule-summary">
                    @foreach (var rule in Model.Scoring.BonusRules)
                    {
                        <p><strong>@BonusPointTypeLabels.FormatPoints(rule.Points):</strong> @BonusPointTypeLabels.Get(rule.Type)</p>
                    }
                </div>
            }
            else
            {
                <p class="meta-inline">Žádné bonusové body nejsou nastavené.</p>
            }
        </section>

        @if (isAdmin && !item.IsLocked)
        {
            <form method="post" asp-page-handler="Update" class="discipline-detail-form">
                <input asp-for="Input.DisciplineId" type="hidden" />

                <div>
                    <label asp-for="Input.Order">Pořadí</label>
                    <input asp-for="Input.Order" type="number" min="1" />
                </div>
                <div>
                    <label asp-for="Input.TeamSize">Velikost týmu</label>
                    <input asp-for="Input.TeamSize" type="number" min="1" max="100" disabled="@(item.TeamCount > 0)" />
                    @if (item.TeamCount > 0)
                    {
                        <input type="hidden" name="Input.TeamSize" value="@Model.Input.TeamSize" />
                    }
                </div>
                <div>
                    <label asp-for="Input.PlayingSystem">Herní systém</label>
                    <select asp-for="Input.PlayingSystem" disabled="@(!canChangePlayingSystem)">
                        @foreach (var system in Enum.GetValues<PlayingSystemType>())
                        {
                            <option value="@system">@DisciplineDetailModel.GetPlayingSystemLabel(system)</option>
                        }
                    </select>
                    @if (!canChangePlayingSystem)
                    {
                        <input asp-for="Input.PlayingSystem" type="hidden" />
                        <small>Herní systém nelze změnit, dokud je rozpis uzamčený.</small>
                    }
                    else if (item.HasPhaseAssignments && !item.HasMatches)
                    {
                        <small>Změna herního systému smaže aktuální rozlosování fází a přiřazení týmů do fází.</small>
                    }
                </div>
                <div>
                    <label class="checkbox-label">
                        @if (setSettingsLocked)
                        {
                            <input type="checkbox" checked="@Model.Input.UsesSetScores" disabled data-uses-set-scores data-set-settings-locked="true" />
                            <input asp-for="Input.UsesSetScores" type="hidden" />
                        }
                        else
                        {
                            <input asp-for="Input.UsesSetScores" data-uses-set-scores />
                        }
                        Hraje se na sety
                    </label>
                    @if (setSettingsLocked)
                    {
                        <small>Nastavení setů nelze změnit, protože disciplína už obsahuje výsledky.</small>
                    }
                </div>
                <div data-sets-to-win-container hidden="@(!Model.Input.UsesSetScores)">
                    <label asp-for="Input.SetsToWin">Výchozí počet setů pro novou fázi</label>
                    <input asp-for="Input.SetsToWin" type="number" min="1" max="10" disabled="@(!Model.Input.UsesSetScores || setSettingsLocked)" />
                    @if (setSettingsLocked)
                    {
                        <input asp-for="Input.SetsToWin" type="hidden" />
                    }
                    <small>
                        Pro každou fázi později zvolíte, zda se odehraje pevný počet setů,
                        nebo zda je potřeba tento počet setů vyhrát.
                    </small>
                </div>
                <div>
                    <label asp-for="Input.ScheduledAt">Datum a čas</label>
                    @Html.TextBox(
                        "Input.ScheduledAt",
                        Model.Input.ScheduledAt?.ToString("dd/MM/yyyy HH:mm"),
                        new { type = "text", inputmode = "numeric", placeholder = "dd/mm/rrrr hh:mm", autocomplete = "off", data_czech_datetime_picker = "true" })
                </div>
                <div class="discipline-description-field">
                    <label asp-for="Input.Description">Informace o disciplíně</label>
                    <textarea asp-for="Input.Description" rows="7" maxlength="2000" placeholder="Pravidla, místo konání nebo jiné informace…"></textarea>
                </div>
                <div class="form-actions discipline-detail-actions">
                    <button class="button" type="submit">Uložit</button>
                </div>
            </form>
        }
        else
        {
            <dl class="details-grid discipline-readonly-details">
                <div><dt>Herní systém</dt><dd>@DisciplineDetailModel.GetPlayingSystemLabel(item.PlayingSystem)</dd></div>
                <div><dt>Velikost týmu</dt><dd>@item.TeamSize</dd></div>
                <div><dt>Datum a čas</dt><dd>@(item.ScheduledAt?.ToString("dd/MM/yyyy HH:mm") ?? "Není určeno")</dd></div>
                <div><dt>Sety</dt><dd>@(item.UsesSetScores ? $"Ano · výchozí počet {item.SetsToWin}" : "Ne")</dd></div>
                <div class="details-wide"><dt>Informace o disciplíně</dt><dd class="discipline-description">@(item.Description ?? "Bez dalších informací.")</dd></div>
            </dl>
        }

        <nav class="form-actions discipline-detail-navigation" aria-label="Stránky disciplíny">
            <a class="button button-ghost"
               asp-page="/Editions/DisciplineParticipants"
               asp-route-id="@Model.Setup.EditionId"
               asp-route-disciplineId="@item.Id">Účastníci a týmy</a>
            @if (item.IsPhaseSetupAvailable)
            {
                <a class="button button-ghost"
                   asp-page="@(item.IsScheduleLocked ? "/Editions/DisciplineResults" : "/Editions/DisciplinePhases")"
                   asp-route-id="@Model.Setup.EditionId"
                   asp-route-disciplineId="@item.Id">@(item.IsScheduleLocked ? "Rozpis a výsledky" : "Rozpis")</a>
            }
        </nav>
    </section>
</main>

@section Scripts {
    <script>
        (() => {
            const checkbox = document.querySelector("[data-uses-set-scores]");
            const container = document.querySelector("[data-sets-to-win-container]");
            const input = container?.querySelector("input");
            if (!checkbox || !container || !input) return;
            const update = () => {
                container.hidden = !checkbox.checked;
                input.disabled = checkbox.dataset.setSettingsLocked === "true" || !checkbox.checked;
                input.required = checkbox.checked;
                if (checkbox.checked && !input.value) input.value = "2";

                document.querySelectorAll('[data-requires-set-scores="true"]').forEach(row => {
                    row.classList.toggle("is-disabled", !checkbox.checked);
                    row.querySelectorAll('input:not([type="hidden"])').forEach(control => {
                        control.disabled = !checkbox.checked;
                    });
                });
            };
            checkbox.addEventListener("change", update);
            update();
        })();
        document.querySelectorAll("[data-point-system-form]").forEach(form => {
            const list = form.querySelector("[data-rule-list]");
            const prefix = form.dataset.prefix;
            form.querySelector("[data-add-rule]")?.addEventListener("click", () => {
                const index = list.children.length;
                const row = document.createElement("div");
                row.className = "point-rule-row";
                row.innerHTML = `<label>Pořadí <input name="${prefix}.Rules[${index}].Rank" value="${index + 1}" type="number" min="1" readonly></label><label>Body <input name="${prefix}.Rules[${index}].Points" value="0" type="number" min="0"></label>`;
                list.appendChild(row);
            });
            form.querySelector("[data-remove-rule]")?.addEventListener("click", () => {
                if (list.children.length > 1) list.lastElementChild.remove();
            });
        });
        document.querySelectorAll("[data-point-system-assignment]").forEach(form => {
            const select = form.querySelector("[data-point-system-select]");
            const submit = form.querySelector("[data-point-system-submit]");
            if (!select || !submit) return;
            const update = () => submit.disabled = select.value === form.dataset.initialValue;
            select.addEventListener("change", update);
            update();
        });
        document.querySelectorAll("[data-bonus-rule-form]").forEach(form => {
            form.querySelectorAll("[data-bonus-rule-autosubmit]").forEach(control => {
                control.addEventListener("change", () => {
                    if (form.dataset.submitting === "true") return;
                    form.dataset.submitting = "true";
                    form.requestSubmit();
                });
            });
        });
    </script>
}
