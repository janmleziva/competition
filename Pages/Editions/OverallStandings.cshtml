@page "/Editions/{id:long}/Standings"
@model Competition.Pages.Editions.OverallStandingsModel
@{
    ViewData["Title"] = $"Celkové pořadí – {Model.Standing.EditionName}";
}

<main class="shell shell-wide">
    <section class="panel admin overall-standings-page">
        <div class="page-heading">
            <div>
                <h1>Celkové pořadí</h1>
                <p class="lead">@Model.Standing.EditionName</p>
            </div>
            <div class="row-actions">
                <a class="button button-ghost" asp-page="/Statistics/Edition" asp-route-id="@Model.Standing.EditionId">Statistiky ročníku</a>
                <a class="button button-ghost" asp-page="/Editions/Details" asp-route-id="@Model.Standing.EditionId">Zpět</a>
            </div>
        </div>

        <p class="meta-inline">
            Rozhodují celkové body, poté počet nejlepších umístění (nejprve vítězství, potom druhá místa atd.).
            Body týmové disciplíny získává v plné výši každý člen týmu.
        </p>

        <form method="get" class="phase-switcher overall-standings-mode" aria-label="Započítání bonusových bodů">
            <button class="phase-switch-button @(Model.IncludeBonusPoints ? "is-active" : null)"
                    type="submit"
                    name="includeBonusPoints"
                    value="true"
                    aria-pressed="@Model.IncludeBonusPoints.ToString().ToLowerInvariant()">
                Včetně bonusových bodů
            </button>
            <button class="phase-switch-button @(!Model.IncludeBonusPoints ? "is-active" : null)"
                    type="submit"
                    name="includeBonusPoints"
                    value="false"
                    aria-pressed="@((!Model.IncludeBonusPoints).ToString().ToLowerInvariant())">
                Bez bonusových bodů
            </button>
        </form>

        <div class="standings-table-scroll">
            <table class="standings-table overall-standings-table">
                <thead>
                    <tr>
                        <th scope="col" class="overall-standing-column">#</th>
                        <th scope="col" class="overall-name-column standings-identity-column">Soutěžící</th>
                        <th scope="col" class="overall-total-column">Celkem</th>
                        @foreach (var discipline in Model.Standing.Disciplines)
                        {
                            <th scope="col" class="overall-discipline-column">
                                @discipline.Name
                                @if (!discipline.IsClosed)
                                {
                                    <span class="standing-pending">neuzavřeno</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Standing.Rows)
                    {
                        <tr>
                            <td class="standing-position overall-standing-column">@row.Place.</td>
                            <th scope="row" class="overall-name-column standings-identity-column">@row.FirstName @row.LastName</th>
                            <td class="standing-points overall-total-column"><strong>@row.TotalPoints b.</strong></td>
                            @foreach (var discipline in Model.Standing.Disciplines)
                            {
                                if (row.Disciplines.TryGetValue(discipline.Id, out var cell))
                                {
                                    <td class="overall-discipline-column">
                                        <strong>@cell.Points b.</strong>
                                        <small>@cell.Rank. místo</small>
                                        <small class="standing-team">@cell.TeamName</small>
                                        @if (Model.IncludeBonusPoints && cell.BonusPoints > 0)
                                        {
                                            <small class="standing-bonus">(@cell.BonusPoints b. bonus)</small>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td class="standing-empty overall-discipline-column">—</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
