<script>
        document.querySelectorAll("[data-phase-auto-submit]").forEach(form => {
            form.querySelectorAll("[data-phase-auto-submit-control]").forEach(control => {
                control.addEventListener("change", () => {
                    if (form.dataset.submitting === "true" || !form.reportValidity()) {
                        return;
                    }
                    form.dataset.submitting = "true";
                    form.classList.add("is-saving");
                    form.requestSubmit();
                });
            });
        });

        document.querySelectorAll("[data-phase-assignment-option]").forEach(option => {
            const checkbox = option.querySelector('input[type="checkbox"]');
            const status = option.querySelector("[data-assignment-status]");
            checkbox?.addEventListener("change", () => {
                option.classList.toggle("is-assigned", checkbox.checked);
                if (status) {
                    status.textContent = checkbox.checked
                        ? (option.closest(".knockout-stage") ? "V etapě" : "Ve skupině")
                        : "K dispozici";
                }

                const teamId = checkbox.dataset.autoAssignTeam;
                const form = checkbox.closest("[data-auto-assignment-form]");
                if (teamId && form) {
                    form.querySelector("[data-focus-team-id]").value = teamId;
                    option.classList.add("is-saving");
                    if (status) {
                        status.textContent = "Ukládám…";
                    }
                    form.requestSubmit();
                }
            });
        });

        document.querySelectorAll("[data-auto-match-team-select]").forEach(select => {
            select.addEventListener("change", () => {
                const formId = select.getAttribute("form");
                const form = formId ? document.getElementById(formId) : null;
                if (!form) {
                    return;
                }

                const focusInput = form.querySelector("[data-match-team-focus-id]");
                if (focusInput) {
                    focusInput.value = select.id;
                }
                select.closest(".match-row")?.classList.add("is-saving");
                form.requestSubmit();
            });
        });

        document.querySelectorAll("[data-phase-switcher]").forEach(switcher => {
            const buttons = Array.from(switcher.querySelectorAll("[data-phase-switch-target]"));
            const cards = Array.from(document.querySelectorAll("[data-phase-filter-card]"));

            buttons.forEach(button => {
                button.addEventListener("click", () => {
                    const target = button.dataset.phaseSwitchTarget;
                    buttons.forEach(item => {
                        const isActive = item === button;
                        item.classList.toggle("is-active", isActive);
                        item.setAttribute("aria-pressed", isActive ? "true" : "false");
                    });

                    cards.forEach(card => {
                        const key = card.dataset.phaseFilterCard;
                        const containsTarget = target !== "all" &&
                            card.querySelector(`[data-phase-filter-card="${CSS.escape(target)}"]`);
                        card.hidden = target !== "all" && key !== target && !containsTarget;
                    });
                });
            });
        });

        if (window.location.hash) {
            const focusedControl = document.getElementById(decodeURIComponent(window.location.hash.substring(1)));
            focusedControl?.focus({ preventScroll: true });
        }

        document.querySelectorAll("[data-phase-actions-toggle]").forEach(button => {
            button.addEventListener("click", () => {
                const isExpanded = button.getAttribute("aria-expanded") === "true";
                button.setAttribute("aria-expanded", (!isExpanded).toString());
            });
        });

        document.querySelectorAll("[data-open-modal], [data-open-set-modal]").forEach(button => {
            button.addEventListener("click", () => {
                const modalId = button.dataset.openModal ?? button.dataset.openSetModal;
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.hidden = false;
                    modal.querySelector("input:not([type='hidden']), button")?.focus();
                }
            });
        });

        document.querySelectorAll("[data-close-modal]").forEach(button => {
            button.addEventListener("click", () => {
                button.closest(".modal-backdrop").hidden = true;
            });
        });

        document.querySelectorAll("form[data-close-modal-after-post='true']").forEach(form => {
            form.addEventListener("submit", () => {
                const modal = form.closest(".modal-backdrop");
                if (modal) {
                    modal.hidden = true;
                }
            });
        });

        document.querySelectorAll(".modal-backdrop").forEach(backdrop => {
            backdrop.addEventListener("click", event => {
                if (event.target === backdrop) {
                    backdrop.hidden = true;
                }
            });
        });
</script>
