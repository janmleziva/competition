@model Competition.Pages.Editions.DisciplinePhasesModel
@using Competition.Domain
@using Competition.Services

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && !Model.Setup.IsClosed;
    var isResultsPage = Model.IsResultsPage;
}

<main class="shell shell-wide @(isResultsPage ? "results-workflow" : "schedule-workflow")">
    <section class="panel admin phase-setup-page">
        <div class="page-heading phase-page-heading">
            <div class="phase-page-title-row">
                <div>
                    <h1>@Model.Setup.DisciplineName</h1>
                    <p class="lead">@(isResultsPage ? "Rozpis a výsledky" : "Tvorba rozpisu") · @Model.Setup.EditionName</p>
                </div>
                <a class="button button-ghost button-back" asp-page="/Editions/Disciplines" asp-route-id="@Model.Setup.EditionId">
                    <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-arrow-left" /></svg>
                    Zpět
                </a>
            </div>
            @if (isResultsPage)
            {
                <button class="phase-actions-toggle"
                        type="button"
                        data-phase-actions-toggle
                        aria-expanded="false"
                        aria-controls="phase-heading-actions">
                    <span>Akce</span>
                    <span class="phase-actions-toggle-icon" aria-hidden="true"></span>
                </button>
            }
            <div id="phase-heading-actions" class="action-group phase-heading-actions">
                @if (isResultsPage && isAuthenticated && Model.Setup.IsClosed)
                {
                    <form method="post" asp-page-handler="Reopen">
                        <button class="button" type="submit"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-unlock" /></svg>Znovu otevřít disciplínu</button>
                    </form>
                }
                @if (isResultsPage && isAuthenticated && !Model.Setup.IsClosed)
                {
                    @if (Model.Scoring.FinalStandings.Count > 0)
                    {
                        <button class="button" type="button" data-open-modal="close-discipline-modal"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-lock" /></svg>Uzavřít</button>
                    }
                    else
                    {
                        <button class="button"
                                type="button"
                                data-open-modal="finalize-discipline-modal"
                                disabled="@(!Model.Scoring.CanFinalize)"
                            title="@Model.Scoring.FinalizeBlockReason">
                            <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-trophy" /></svg>
                            Přidělit body a uzavřít
                        </button>
                    }
                }
                @if (!isResultsPage && isAdmin && Model.HasMatches)
                {
                    <button class="button" type="button" data-open-modal="lock-schedule-modal"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-lock" /></svg>Uzamknout rozpis</button>
                }
                @if (isResultsPage && isAdmin && Model.HasMatches)
                {
                    <form method="post" asp-page-handler="UnlockSchedule">
                        <button class="button button-ghost"
                                type="submit"
                                disabled="@Model.Setup.HasMatchResults"
                            title="@(Model.Setup.HasMatchResults ? "Rozpis s uloženými výsledky už nelze odemknout." : null)">
                            <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-unlock" /></svg>
                            Odemknout rozpis
                        </button>
                    </form>
                }
                @if (isResultsPage && isAdmin && Model.HasMatches)
                {
                    <button class="button button-ghost"
                            type="button"
                            data-open-modal="random-results-modal"
                            disabled="@(Model.Scoring.FinalStandings.Count > 0 || (Model.Setup.PlayingSystem == PlayingSystemType.Knockout && !Model.Setup.IsScheduleLocked))"
                            title="@(Model.Scoring.FinalStandings.Count > 0 ? "Nejprve odeberte přidělené body." : Model.Setup.PlayingSystem == PlayingSystemType.Knockout && !Model.Setup.IsScheduleLocked ? "Nejprve uzamkněte rozpis." : null)">
                        <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-shuffle" /></svg>
                        Náhodně vygenerovat výsledky
                    </button>
                    @if (Model.Scoring.FinalStandings.Count > 0)
                    {
                        <button class="button button-danger"
                                type="button"
                                data-open-modal="remove-awarded-points-modal">
                            <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-trash" /></svg>
                            Odebrat přidělené body
                        </button>
                    }
                    <button class="button button-danger"
                            id="delete-results-button"
                            type="button"
                            data-open-modal="delete-results-modal">
                        <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-trash" /></svg>
                        Smazat výsledky
                    </button>
                }
                @if (!isResultsPage && isAdmin && Model.HasMatches)
                {
                    <button class="button button-danger"
                            type="button"
                            data-open-modal="reset-schedule-modal"
                            disabled="@(!Model.Setup.CanResetSchedule)"
                            title="@(!Model.Setup.CanResetSchedule ? "Rozpis obsahuje výsledky a nelze jej smazat." : null)">
                        <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-trash" /></svg>
                        Smazat rozpis
                    </button>
                }
            </div>
        </div>

        @if (isResultsPage && isAuthenticated && !Model.Setup.IsClosed && Model.Scoring.AwardPointSystemId is null)
        {
            <div class="point-system-missing-notice" role="status">
                <strong>Pro disciplínu není vybraný bodovací systém.</strong>
                <span>Body zatím nelze přidělit.</span>
                <a asp-page="/Editions/DisciplineDetail"
                   asp-route-id="@Model.Setup.EditionId"
                   asp-route-disciplineId="@Model.Setup.DisciplineId">Vybrat bodovací systém v nastavení disciplíny</a>
            </div>
        }

        <section class="playing-system-banner @(Model.Setup.IsScheduleLocked ? "is-locked" : null)" aria-label="Vybraný herní systém">
            <div class="playing-system-banner-heading">
                <span class="playing-system-label">Herní systém</span>
                @if (Model.Setup.IsScheduleLocked && !Model.Setup.IsClosed)
                {
                    <span class="schedule-lock-badge">Rozpis uzamčen</span>
                }
                @if (Model.Setup.IsClosed)
                {
                    <span class="schedule-lock-badge discipline-closed-badge">Disciplína uzavřena</span>
                }
            </div>
            <div class="playing-system-value">
                @if (!isResultsPage && isAdmin && !Model.HasMatches && !Model.Setup.IsScheduleLocked)
                {
                    <form method="post" asp-page-handler="ChangePlayingSystem" class="playing-system-change-form">
                        <select asp-for="SelectedPlayingSystem" aria-label="Herní systém">
                            @foreach (var system in Enum.GetValues<PlayingSystemType>())
                            {
                                <option value="@system">@DisciplinePhasesModel.GetPlayingSystemLabel(system)</option>
                            }
                        </select>
                        <button class="button button-small" type="submit"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-settings" /></svg>Změnit</button>
                    </form>
                }
                else
                {
                    <strong>@DisciplinePhasesModel.GetPlayingSystemLabel(Model.Setup.PlayingSystem)</strong>
                }
            </div>
        </section>

        @if (!isResultsPage && isAdmin && Model.HasMatches)
        {
            <div class="schedule-lock-notice" role="note">
                <strong>Je rozpis hotový?</strong>
                Uzamknutím přejdete k zapisování výsledků. Rozpis pak půjde odemknout jen do chvíle, než bude uložen první výsledek.
            </div>
        }

        @if (isResultsPage && Model.Setup.IsClosed)
        {
            <div class="schedule-lock-notice closed-state-notice" role="status">
                <strong>Disciplína je uzavřená.</strong>
                Konečné pořadí a body byly přiděleny. Rozpis ani výsledky už nelze měnit.
            </div>
        }

        @if (isResultsPage && !isAdmin && !Model.Setup.IsAnonymousResultEditingEnabled)
        {
            <div class="schedule-lock-notice closed-state-notice" role="status">
                <strong>Veřejná editace výsledků je uzavřená.</strong>
                Aktuální rozpis a uložené výsledky zůstávají veřejně dostupné jen pro čtení.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="status-message" role="status">@Model.StatusMessage</div>
        }
        @if (Model.ValidationSection is null)
        {
            <div asp-validation-summary="ModelOnly" class="error validation-panel"></div>
        }

        @if (Model.ShouldShowPhaseFilter)
        {
            <nav class="phase-switcher" aria-label="Zobrazení fáze nebo skupiny" data-phase-switcher>
                <button class="phase-switch-button is-active" type="button" data-phase-switch-target="all" aria-pressed="true">Vše</button>
                @foreach (var item in Model.GetPhaseFilterItems())
                {
                    <button class="phase-switch-button" type="button" data-phase-switch-target="@item.Key" aria-pressed="false">@item.Label</button>
                }
            </nav>
        }

        @if (Model.Setup.PlayingSystem == PlayingSystemType.RoundRobin)
        {
            var phase = Model.Setup.Phases.Single(x => x.Type == PhaseType.Group);
            var group = phase.Groups.Single();
            <article class="phase-card" data-phase-filter-card="group-@group.Id">
                <div class="phase-card-heading">
                    <div>
                        <h2>Každý s každým</h2>
                    </div>
                </div>

                <partial name="_PhasePointsForm" model="new PhasePointsFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />

                @if (Model.Setup.UsesSetScores)
                {
                    <partial name="_PhaseSetRuleForm" model="new PhaseSetRuleFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />
                }

                @if (isResultsPage && Model.GroupStandings.TryGetValue(group.Id, out var roundRobinStandings))
                {
                    <partial name="_GroupStandings" model="roundRobinStandings" />
                }

                @if (!isResultsPage && group.Matches.Count == 0 && isAdmin)
                {
                    <form method="post" asp-page-handler="GeneratePresetMatches" class="phase-primary-action">
                        <button class="button" type="submit" disabled="@(Model.Setup.Teams.Count < 2)">
                            <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-calendar" /></svg>
                            Vygenerovat zápasy podle Bergerových tabulek
                        </button>
                    </form>
                }

                @if (group.Matches.Count > 0)
                {
                    <section class="fixture-section">
                        <h3>Rozpis zápasů</h3>
                        <partial name="_PhaseMatchList"
                                 model="new PhaseMatchListViewModel(group.Matches, phase.SetRule, phase.SetCount, Model.CanEditResults(isAdmin), false, Model.MatchStatusMessage, Model.MatchStatusMatchId, ValidationMessage: Model.MatchValidationMessage, ValidationMatchId: Model.MatchValidationMatchId, ShowTeamSeed: isResultsPage && Model.Setup.TeamSize > 1, ShowResultsControls: isResultsPage, AttemptedSetScores: Model.SetScoresInput, ValidationIsSetScores: Model.MatchValidationIsSetScores)" />
                    </section>
                }
            </article>
        }
        else if (Model.Setup.PlayingSystem == PlayingSystemType.GroupsThenClassificationMatches)
        {
            var groupPhases = Model.Setup.Phases.Where(x => x.Type == PhaseType.Group).OrderBy(x => x.Order).ToList();
            @foreach (var phase in groupPhases)
            {
                var group = phase.Groups.Single();
                var options = Model.GetAssignableTeams(group);
                <article class="phase-card" data-phase-filter-card="group-@group.Id">
                    <div class="phase-card-heading">
                        <div class="phase-title-with-order">
                            <span class="seed-badge">@phase.Order</span>
                            <div><span class="phase-eyebrow">Skupinová fáze</span><h2>@phase.Name</h2></div>
                        </div>
                    </div>

                    <partial name="_PhasePointsForm" model="new PhasePointsFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />

                    @if (Model.Setup.UsesSetScores)
                    {
                        <partial name="_PhaseSetRuleForm" model="new PhaseSetRuleFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />
                    }

                    @if (!isResultsPage && group.Matches.Count == 0 && isAdmin)
                    {
                        <div class="random-assignment-form random-assignment-all-form">
                            <button class="button button-ghost button-small" type="button" data-open-modal="random-assignment-modal" disabled="@(Model.Setup.Teams.Count == 0)">
                                <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-shuffle" /></svg>
                                Náhodně přiřadit týmy
                            </button>
                        </div>
                        <form id="group-@group.Id" method="post" asp-page-handler="AssignGroupTeams" class="group-assignment-form" data-auto-assignment-form>
                            <input type="hidden" name="phaseId" value="@phase.Id" />
                            <input type="hidden" name="groupId" value="@group.Id" />
                            <input type="hidden" name="focusTeamId" value="" data-focus-team-id />
                            <div class="participant-list phase-team-list">
                                @foreach (var team in options)
                                {
                                    var isSelected = group.TeamIds.Contains(team.Id);
                                    <label class="participant-option participant-option-content phase-assignment-option @(isSelected ? "is-assigned" : null)"
                                           data-phase-assignment-option>
                                        <input id="group-@group.Id-team-@team.Id"
                                               type="checkbox"
                                               name="teamIds"
                                               value="@team.Id"
                                               checked="@isSelected"
                                               data-auto-assign-team="@team.Id" />
                                        <span class="seed-badge">@team.Seed</span>
                                        <span class="participant-name">@team.Name</span>
                                        <span class="assignment-status" data-assignment-status>
                                            @(isSelected ? "Ve skupině" : "K dispozici")
                                        </span>
                                    </label>
                                }
                            </div>
                        </form>

                    }

                    @if (isResultsPage && Model.GroupStandings.TryGetValue(group.Id, out var groupStandings))
                    {
                        <partial name="_GroupStandings" model="groupStandings" />
                    }

                    @if (group.Matches.Count > 0)
                    {
                        <section class="fixture-section">
                            <h3>Rozpis</h3>
                            <partial name="_PhaseMatchList"
                                     model="new PhaseMatchListViewModel(group.Matches, phase.SetRule, phase.SetCount, Model.CanEditResults(isAdmin), false, Model.MatchStatusMessage, Model.MatchStatusMatchId, ValidationMessage: Model.MatchValidationMessage, ValidationMatchId: Model.MatchValidationMatchId, ShowTeamSeed: isResultsPage && Model.Setup.TeamSize > 1, ShowResultsControls: isResultsPage, AttemptedSetScores: Model.SetScoresInput, ValidationIsSetScores: Model.MatchValidationIsSetScores)" />
                        </section>
                    }
                </article>
            }

            var finalPhase = Model.Setup.Phases.Single(x => x.Type == PhaseType.FinalStanding);
            <article class="phase-card final-phase-card" data-phase-filter-card="phase-@finalPhase.Id">
                <div class="phase-card-heading">
                    <div class="phase-title-with-order"><span class="seed-badge">@finalPhase.Order</span><div><span class="phase-eyebrow">Finálová fáze</span><h2>@finalPhase.Name</h2></div></div>
                </div>
                @if (Model.Setup.UsesSetScores)
                {
                    <partial name="_PhaseSetRuleForm" model="new PhaseSetRuleFormViewModel(finalPhase, !isResultsPage && isAdmin && !finalPhase.HasResults)" />
                }
                @if (finalPhase.Matches.Count == 0)
                {
                    <p class="meta-inline">Finále a zápas o 3. místo se vytvoří společně se skupinovými zápasy.</p>
                }
                else
                {
                    <partial name="_PhaseMatchList"
                             model="new PhaseMatchListViewModel(finalPhase.Matches, finalPhase.SetRule, finalPhase.SetCount, Model.CanEditResults(isAdmin), true, Model.MatchStatusMessage, Model.MatchStatusMatchId, ValidationMessage: Model.MatchValidationMessage, ValidationMatchId: Model.MatchValidationMatchId, ShowTeamSeed: isResultsPage && Model.Setup.TeamSize > 1, ShowResultsControls: isResultsPage, AttemptedSetScores: Model.SetScoresInput, ValidationIsSetScores: Model.MatchValidationIsSetScores)" />
                }
            </article>

            @if (!isResultsPage && !Model.HasMatches && isAdmin)
            {
                <form method="post" asp-page-handler="GeneratePresetMatches" class="phase-primary-action phase-page-action">
                    <button class="button" type="submit" disabled="@(!Model.Setup.AreAllTeamsAssigned)" title="@(Model.Setup.AreAllTeamsAssigned ? null : "Nejprve rozdělte všechny týmy do skupin.")">
                        <svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-calendar" /></svg>
                        Vygenerovat skupinové a finálové zápasy
                    </button>
                </form>
            }
        }
        else if (Model.Setup.PlayingSystem == PlayingSystemType.Knockout)
        {
            var phase = Model.Setup.Phases.Single(x => x.Type == PhaseType.Knockout);
            <article class="phase-card" data-phase-filter-card="phase-@phase.Id">
                <div class="phase-card-heading">
                    <div><span class="phase-eyebrow">Vyřazovací fáze</span><h2>@phase.Name</h2></div>
                </div>

                @if (Model.Setup.UsesSetScores)
                {
                    <partial name="_PhaseSetRuleForm" model="new PhaseSetRuleFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />
                }

                @if (!isResultsPage && !Model.HasMatches && isAdmin)
                {
                    <div class="knockout-guidance" role="note">
                        <strong>Etapy vytvářejte v pořadí, v jakém se budou hrát.</strong>
                        U každé etapy zadejte jen počet týmů, které v ní přímo začínají. Vítězové zápasů z předchozí etapy
                        budou do následující etapy doplněni automaticky.
                    </div>
                }

                @{
                    var previousStageCapacity = 0;
                    var previousStageMatches = Enumerable.Empty<Competition.Services.PhaseSetupMatch>().ToList();
                }
                @foreach (var stage in phase.Groups)
                {
                    var advancingTeamCount = previousStageCapacity / 2;
                    var directTeamCapacity = Math.Max(0, stage.Capacity.GetValueOrDefault() - advancingTeamCount);
                    var options = Model.GetAssignableTeams(stage, directTeamCapacity);
                    var sourceOptions = previousStageMatches
                        .Select(x => new Competition.Services.PhaseSetupMatchSource(x.Id, x.Name))
                        .ToList();
                    <section class="knockout-stage">
                        <div class="stage-heading">
                            <div class="stage-title-block">
                                <div><span class="seed-badge">@stage.Order</span><h3>@stage.Name</h3></div>
                                @if (!isResultsPage && !Model.HasMatches && isAdmin)
                                {
                                    <small>Vyberte tým nebo týmy, které začínají přímo v této etapě.</small>
                                }
                            </div>
                            <div class="stage-actions">
                                <span class="points-badge">@directTeamCapacity nasazení</span>
                                @if (advancingTeamCount > 0)
                                {
                                    <span class="advancing-teams-badge">+ @advancingTeamCount postupující</span>
                                }
                                @if (!isResultsPage && isAdmin && stage.TeamIds.Count == 0 && stage.Matches.Count == 0)
                                {
                                    <form method="post" asp-page-handler="DeleteGroup">
                                        <input type="hidden" name="phaseId" value="@phase.Id" />
                                        <input type="hidden" name="groupId" value="@stage.Id" />
                                        <button class="button button-danger button-small" type="submit"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-trash" /></svg>Smazat</button>
                                    </form>
                                }
                            </div>
                        </div>
                        @if (!isResultsPage && !Model.HasMatches && isAdmin)
                        {
                            <form id="group-@stage.Id" method="post" asp-page-handler="AssignGroupTeams" class="group-assignment-form" data-auto-assignment-form>
                                <input type="hidden" name="phaseId" value="@phase.Id" />
                                <input type="hidden" name="groupId" value="@stage.Id" />
                                <input type="hidden" name="focusTeamId" value="" data-focus-team-id />
                                <div class="participant-list phase-team-list">
                                    @foreach (var team in options)
                                    {
                                        var isSelected = stage.TeamIds.Contains(team.Id);
                                        <label class="participant-option participant-option-content phase-assignment-option @(isSelected ? "is-assigned" : null)"
                                               data-phase-assignment-option>
                                            <input id="group-@stage.Id-team-@team.Id"
                                                   type="checkbox"
                                                   name="teamIds"
                                                   value="@team.Id"
                                                   checked="@isSelected"
                                                   data-auto-assign-team="@team.Id" />
                                            <span class="seed-badge">@team.Seed</span>
                                            <span class="participant-name">@team.Name</span>
                                            <span class="assignment-status" data-assignment-status>
                                                @(isSelected ? "V etapě" : "K dispozici")
                                            </span>
                                        </label>
                                    }
                                </div>
                            </form>
                        }
                        @if (stage.Matches.Count > 0)
                        {
                            <partial name="_PhaseMatchList"
                                     model="new PhaseMatchListViewModel(stage.Matches, phase.SetRule, phase.SetCount, Model.CanEditResults(isAdmin), true, Model.MatchStatusMessage, Model.MatchStatusMatchId, isAdmin && !Model.Setup.IsScheduleLocked, Model.Setup.Teams.Where(x => stage.TeamIds.Contains(x.Id)).ToList(), sourceOptions, Model.MatchValidationMessage, Model.MatchValidationMatchId, isResultsPage && Model.Setup.TeamSize > 1, ShowResultsControls: isResultsPage, AttemptedSetScores: Model.SetScoresInput, ValidationIsSetScores: Model.MatchValidationIsSetScores)" />
                        }
                    </section>
                    previousStageCapacity = stage.Capacity.GetValueOrDefault();
                    previousStageMatches = stage.Matches.ToList();
                }

                @if (!isResultsPage && !Model.HasMatches && isAdmin)
                {
                    <section class="stage-create-box">
                        <h3>Nová etapa</h3>
                        <p class="meta-inline">Nejprve zadejte první hranou etapu, potom postupně přidávejte navazující etapy.</p>
                        @if (Model.ValidationSection == "group-create")
                        {
                            <div asp-validation-summary="ModelOnly" class="error validation-panel local-validation-panel"></div>
                        }
                        <form method="post" asp-page-handler="CreateGroup" class="discipline-settings-grid">
                            <input type="hidden" name="phaseId" value="@phase.Id" />
                            <input type="hidden" name="NewGroup.Order" value="@(phase.Groups.Count == 0 ? 1 : phase.Groups.Max(x => x.Order) + 1)" />
                            <div><label asp-for="NewGroup.Name">Název</label><input asp-for="NewGroup.Name" placeholder="např. Čtvrtfinále" /></div>
                            <div><label asp-for="NewGroup.Capacity">Počet týmů</label><input asp-for="NewGroup.Capacity" type="number" min="2" step="2" /></div>
                            <button class="button button-small" type="submit">Přidat etapu</button>
                        </form>
                    </section>

                    @if (phase.Groups.Count > 0)
                    {
                        <div class="phase-primary-action knockout-generation-actions">
                            @if (Model.ValidationSection == "knockout-generation")
                            {
                                <div asp-validation-summary="ModelOnly" class="error validation-panel local-validation-panel knockout-generation-error"></div>
                            }
                            <form method="post" asp-page-handler="GenerateKnockoutMatches">
                                <input type="hidden" name="randomizeTeams" value="true" />
                                <button class="button" type="submit"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-shuffle" /></svg>Vygenerovat pavouk náhodně</button>
                            </form>
                            <form method="post" asp-page-handler="GenerateKnockoutMatches">
                                <input type="hidden" name="randomizeTeams" value="false" />
                                <button class="button button-ghost" type="submit"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-calendar" /></svg>Sestavit zápasy ručně</button>
                            </form>
                        </div>
                    }
                }
            </article>
        }
        else if (Model.Setup.PlayingSystem == PlayingSystemType.Custom)
        {
            @if (!isResultsPage && isAdmin)
            {
                <section class="phase-card custom-phase-create">
                    <div class="phase-card-heading"><div><span class="phase-eyebrow">Vlastní systém</span><h2>Nová fáze</h2></div></div>
                    <form method="post" asp-page-handler="CreatePhase" class="discipline-settings-grid">
                        <div><label asp-for="NewPhase.Name">Název</label><input asp-for="NewPhase.Name" /></div>
                        <div>
                            <label asp-for="NewPhase.Type">Typ</label>
                            <select asp-for="NewPhase.Type">
                                @foreach (var type in Enum.GetValues<PhaseType>())
                                {
                                    <option value="@type">@DisciplinePhasesModel.GetPhaseTypeLabel(type)</option>
                                }
                            </select>
                        </div>
                        <div><label asp-for="NewPhase.Order">Pořadí</label><input asp-for="NewPhase.Order" type="number" min="1" /></div>
                        <div><label asp-for="NewPhase.PointsForWin">Výhra</label><input asp-for="NewPhase.PointsForWin" type="number" min="0" /></div>
                        <div><label asp-for="NewPhase.PointsForDraw">Remíza</label><input asp-for="NewPhase.PointsForDraw" type="number" min="0" /></div>
                        <div><label asp-for="NewPhase.PointsForLoss">Prohra</label><input asp-for="NewPhase.PointsForLoss" type="number" min="0" /></div>
                        @if (Model.Setup.UsesSetScores)
                        {
                            <div>
                                <label asp-for="NewPhase.SetRule">Pravidlo setů</label>
                                <select asp-for="NewPhase.SetRule">
                                    @foreach (var rule in Enum.GetValues<SetRuleType>())
                                    {
                                        <option value="@rule">@DisciplinePhasesModel.GetSetRuleLabel(rule)</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label asp-for="NewPhase.SetCount">Počet setů</label>
                                <input asp-for="NewPhase.SetCount" type="number" min="1" max="10" required />
                            </div>
                        }
                        <button class="button button-small" type="submit">Přidat fázi</button>
                    </form>
                </section>
            }

            @if (Model.Setup.Phases.Count == 0)
            {
                <div class="empty-state">Vlastní systém zatím nemá žádnou fázi.</div>
            }
            @foreach (var phase in Model.Setup.Phases)
            {
                var assignedCount = phase.Groups.SelectMany(x => x.TeamIds).Distinct().Count();
                var phaseHasMatches = phase.Matches.Count != 0 || phase.Groups.Any(x => x.Matches.Count != 0);
                <article class="phase-card" data-phase-filter-card="phase-@phase.Id">
                    <div class="phase-card-heading">
                        <div class="phase-title-with-order">
                            <span class="seed-badge">@phase.Order</span>
                            <div><span class="phase-eyebrow">@DisciplinePhasesModel.GetPhaseTypeLabel(phase.Type)</span><h2>@phase.Name</h2></div>
                        </div>
                        <div class="stage-actions">
                            <span class="points-badge">@assignedCount týmů</span>
                            @if (!isResultsPage && isAdmin && assignedCount == 0 && !phaseHasMatches)
                            {
                                <form method="post" asp-page-handler="DeletePhase">
                                    <input type="hidden" name="phaseId" value="@phase.Id" />
                                    <button class="button button-danger button-small" type="submit"><svg class="button-action-icon" aria-hidden="true"><use href="#action-icon-trash" /></svg>Smazat</button>
                                </form>
                            }
                        </div>
                    </div>
                    @if (phase.Type == PhaseType.Group)
                    {
                        <partial name="_PhasePointsForm" model="new PhasePointsFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />
                    }
                    @if (Model.Setup.UsesSetScores)
                    {
                        <partial name="_PhaseSetRuleForm" model="new PhaseSetRuleFormViewModel(phase, !isResultsPage && isAdmin && !phase.HasResults)" />
                    }
                    @if (phase.Type == PhaseType.Group)
                    {
                        @foreach (var group in phase.Groups)
                        {
                            @if (isResultsPage && Model.GroupStandings.TryGetValue(group.Id, out var customStandings))
                            {
                                <div data-phase-filter-card="group-@group.Id">
                                    <partial name="_GroupStandings" model="customStandings" />
                                </div>
                            }
                        }
                    }
                </article>
            }
        }
        else
        {
            <div class="empty-state">Automatické nastavení tohoto herního systému připravíme v dalším kroku.</div>
        }


        @if (isResultsPage && Model.FinalStandings is not null)
        {
            <article class="phase-card final-standings-card" data-phase-filter-card="final-standings">
                <partial name="_FinalStandings" model="Model.FinalStandings" />
                @if (Model.Scoring.BonusRules is { Count: > 0 })
                {
                    <section class="standings-section bonus-points-results" aria-labelledby="bonus-points-title">
                        <div class="phase-card-heading">
                            <div>
                                <h2 id="bonus-points-title">Bonusové body</h2>
                            </div>
                        </div>
                        <div class="bonus-result-list">
                            @foreach (var rule in Model.Scoring.BonusRules)
                            {
                                var winners = (Model.Scoring.BonusAwards ?? [])
                                    .Where(award => award.Type == rule.Type)
                                    .ToList();
                                var otherPlacements = (Model.Scoring.BonusMetricStandings ?? [])
                                    .Where(standing => standing.Type == rule.Type && standing.Rank > 1)
                                    .ToList();
                                <article class="bonus-result-item">
                                    <h3>@BonusPointTypeLabels.Get(rule.Type)</h3>
                                    <p class="bonus-result-winner">
                                        <strong>@BonusPointTypeLabels.FormatPoints(rule.Points):</strong>
                                        @if (winners.Count > 0)
                                        {
                                            @string.Join(", ", winners.Select(winner =>
                                                $"{winner.TeamName} ({BonusPointTypeLabels.FormatMetric(winner.MetricTotal, winner.MatchCount)})"))
                                        }
                                        else
                                        {
                                            <span class="meta-inline">zatím nepřiděleno</span>
                                        }
                                    </p>
                                    @if (winners.Count > 0 && otherPlacements.Count > 0)
                                    {
                                        <p class="bonus-result-others">
                                            <strong>Další umístění:</strong>
                                            @string.Join(", ", otherPlacements.Select(standing =>
                                                $"{standing.Rank}. {standing.TeamName} ({BonusPointTypeLabels.FormatMetric(standing.MetricTotal, standing.MatchCount)})"))
                                        </p>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            </article>
        }
    </section>
</main>

