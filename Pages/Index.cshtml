@page
@model IndexModel
@{
    ViewData["Title"] = Model.Edition?.Name ?? Model.Settings.Title;
}

<main class="shell">
    <section class="panel hero home-hero">
        @if (Model.Edition is not null)
        {
            <a class="home-edition-feature" asp-page="/Editions/Details" asp-route-id="@Model.Edition.Id">

                <h1 class="home-edition-name">@Model.Edition.Name</h1>
                <span class="home-edition-meta">@Model.Edition.City · @Model.EditionDateDisplay</span>
                <span class="home-edition-cta">Otevřít soutěž <span aria-hidden="true">→</span></span>
            </a>
        }
        else
        {
            <div class="home-fallback-heading">
                <h1>@Model.Settings.Title</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Lead))
                {
                    <p class="lead">@Model.Lead</p>
                }
            </div>
        }

        @if (!Model.IsCompetitionRunning)
        {
            <section class="home-countdown-section">
                <div class="home-countdown-intro">
                    <h2>@Model.Heading</h2>
                    @if (Model.Edition is null)
                    {
                        <span>@Model.EditionDateDisplay</span>
                    }
                </div>

                <div class="countdown" aria-label="Odpočet" data-countdown-target="@Model.CountdownTarget.ToString("O")">
                    <div class="unit"><span class="value" data-unit="days">--</span><span class="label">Dny</span></div>
                    <div class="unit"><span class="value" data-unit="hours">--</span><span class="label">Hodiny</span></div>
                    <div class="unit"><span class="value" data-unit="minutes">--</span><span class="label">Minuty</span></div>
                    <div class="unit"><span class="value" data-unit="seconds">--</span><span class="label">Sekundy</span></div>
                </div>
            </section>
        }
        else
        {
            <section class="home-live-state">
                <span class="home-live-dot" aria-hidden="true"></span>
                <div>
                    <h2>@Model.Heading</h2>
                    <p>@Model.Lead</p>
                </div>
            </section>
        }

        @if (Model.IsDevelopment)
        {
            <div class="env">Prostředí: @Model.EnvironmentName</div>
        }
    </section>
</main>

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
