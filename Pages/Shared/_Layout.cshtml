@using Competition.Configuration
@using Microsoft.Extensions.Options
@inject IOptionsMonitor<ThemeSettings> ThemeOptions
@{
    var theme = ThemeOptions.CurrentValue;
}
<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Competition</title>
    <style>
        :root {
            --bg: @theme.Background;
            --bg-soft: @theme.BackgroundSoft;
            --panel: @theme.Panel;
            --text: @theme.Text;
            --muted: @theme.Muted;
            --accent: @theme.Accent;
            --accent-strong: @theme.AccentStrong;
            --font-family: @theme.FontFamily;
            --radius: @theme.BorderRadius;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Hlavní navigace">
            <a asp-page="/Editions/Index">Soutěže</a>
            <a asp-page="/Competitors/Index">Soutěžící</a>
            <a asp-page="/Disciplines/Index">Disciplíny</a>
            <a asp-page="/PointSystems/Index">Bodování</a>
        </nav>

        <div class="auth-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-page="/Account/Logout">
                    <button class="button button-ghost button-header" type="submit">Odhlásit se</button>
                </form>
            }
            else
            {
                <a class="button button-ghost button-header" asp-page="/Account/Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")">Přihlásit se</a>
            }
        </div>
    </header>

    @RenderBody()
    <script src="~/js/czech-date-picker.js" asp-append-version="true" defer></script>
    <script src="~/js/preserve-postback-position.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
