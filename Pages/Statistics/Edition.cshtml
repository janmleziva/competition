@page "/Editions/{id:long}/Statistics"
@model Competition.Pages.Statistics.EditionModel
@{
    ViewData["Title"] = $"Statistiky – {Model.Statistics.EditionName}";
}

<main class="shell shell-wide">
    <section class="panel admin competitor-stats-page">
        <div class="page-heading">
            <div>
                <h1>Statistiky ročníku</h1>
                <p class="lead">@Model.Statistics.EditionName · @Model.Statistics.StartDate.Year</p>
            </div>
        </div>

        <nav class="phase-switcher competitor-stats-tabs" aria-label="Způsob řazení" data-stats-tabs>
            <button class="phase-switch-button is-active" type="button" data-stats-target="placements" aria-controls="edition-by-placements" aria-pressed="true">Podle umístění</button>
            <button class="phase-switch-button" type="button" data-stats-target="points" aria-controls="edition-by-points" aria-pressed="false">Podle bodů</button>
        </nav>

        <section id="edition-by-placements" class="competitor-stats-view" data-stats-view="placements">
            <h2>Pořadí podle umístění</h2>
            <partial name="_IndividualRankingTable" model="new Competition.Services.IndividualRankingTableModel(Model.Statistics.ByPlacements, Competition.Services.IndividualRankingTableMode.Placements, Model.Statistics.EditionId)" />
        </section>

        <section id="edition-by-points" class="competitor-stats-view" data-stats-view="points" hidden>
            <h2>Pořadí podle získaných bodů</h2>
            <partial name="_IndividualRankingTable" model="new Competition.Services.IndividualRankingTableModel(Model.Statistics.ByPoints, Competition.Services.IndividualRankingTableMode.Points, Model.Statistics.EditionId)" />
        </section>
    </section>
</main>

<partial name="_StatisticsTabsScript" />
