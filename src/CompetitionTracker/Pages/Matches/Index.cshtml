@page
@model CompetitionTracker.Pages.Matches.IndexModel
@{
    ViewData["Title"] = "Matches";
}
<h1>Matches</h1>
<form method="post" class="card form-card">
    <label>Discipline
        <select asp-for="Input.DisciplineId" asp-items="Model.DisciplineOptions"></select>
    </label>
    <label>Round <input asp-for="Input.RoundName" /></label>
    <label>Scheduled at <input asp-for="Input.ScheduledAt" type="datetime-local" /></label>
    <label class="checkbox"><input asp-for="Input.IsComplete" /> Complete</label>
    <button class="button primary" type="submit">Add match</button>
</form>
<div class="stack">
@foreach (var match in Model.Matches)
{
    <article class="card"><h2>@match.Discipline?.Name</h2><p>@match.RoundName · @match.ScheduledAt.LocalDateTime.ToString("g")</p><p>@(match.IsComplete ? "Complete" : "Scheduled")</p></article>
}
</div>
